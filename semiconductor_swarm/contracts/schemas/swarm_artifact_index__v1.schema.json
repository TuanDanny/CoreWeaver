{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Swarm Artifact Index v1",
  "type": "object",
  "required": ["contract_version", "run_id", "project_name", "created_at", "status", "agents", "contracts", "artifacts", "dependency_graph", "summary"],
  "properties": {
    "contract_version": {"type": "string", "const": "swarm_artifact_index/v1"},
    "run_id": {"type": "string"},
    "project_name": {"type": "string"},
    "created_at": {"type": "string"},
    "status": {"type": "string", "enum": ["pass", "fail", "partial", "not_run"]},
    "agents": {"type": "object"},
    "contracts": {"type": "array"},
    "artifacts": {"type": "array"},
    "dependency_graph": {"type": "array"},
    "summary": {"type": "object"}
  }
}