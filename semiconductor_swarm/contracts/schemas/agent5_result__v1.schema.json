    "properties_generated": {"type": "array"},
    "proof_results": {"type": "array"},
    "counterexamples": {"type": "array"},
    "engines": {"type": "array"},
    "bounded_depth": {"type": "integer"},
    "commands": {"type": "array"},
    "tool_availability": {"type": "object"},
    "artifacts": {"type": "array"}
  }
}