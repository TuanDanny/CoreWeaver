{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent 3 Result Contract v1",
  "type": "object",
  "required": ["contract_version", "project_name", "pass_fail_status", "coverage_summary", "failures", "tool_availability", "commands", "artifacts"],
  "properties": {
    "contract_version": {"type": "string", "const": "agent3_result/v1"},
    "project_name": {"type": "string"},
    "pass_fail_status": {"type": "string", "enum": ["pass", "fail", "partial", "not_run"]},
    "coverage_summary": {"type": "object"},
    "failures": {"type": "array"},
    "tool_availability": {"type": "object"},
    "commands": {"type": "array"},
    "artifacts": {"type": "array"}
  }
}