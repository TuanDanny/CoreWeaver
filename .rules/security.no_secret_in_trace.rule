{
  "id": "security.no_secret_in_trace",
  "version": "1.0.0",
  "severity": "blocker",
  "description": "Secret findings are forbidden in trace, debug, artifacts, and harness-visible text.",
  "applies_to": "security",
  "when": {
    "secret_finding_exists": {}
  },
  "then": {
    "block": {
      "action": "harness_release"
    }
  }
}
