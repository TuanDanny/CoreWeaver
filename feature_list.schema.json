{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreWeaver Feature List",
  "type": "object",
  "required": [
    "version",
    "features"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "in_progress",
              "done",
              "blocked"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
